# NSW RealVision webapp settings. Copy to .env.local for local development; every value is optional.
# See docs/self-hosting.md for the full reference.

# --- DuckDB (local file, the default) ---
# Defaults to ../data/realvision.duckdb (the file the ETL in scripts/ writes).
# DUCKDB_PATH=../data/realvision.duckdb

# --- DuckDB on object storage (optional) ---
# When set, the server attaches this DuckDB file read-only over httpfs instead of opening a local
# file. Credentials come from the standard AWS environment variables or profile.
# DUCKDB_S3_PATH=s3://your-bucket/realvision.duckdb
# AWS_REGION=ap-southeast-2

# --- DuckDB resources ---
# DUCKDB_MEMORY_LIMIT=512MB
# DUCKDB_THREADS=2

# --- Server (production build and Docker) ---
# HOST=0.0.0.0
# PORT=3000

# --- Map tiles (build time) ---
# The defaults need no API key: OpenStreetMap raster tiles, OpenFreeMap vector tiles and styles,
# and the OpenMapTiles font server. They are free community services with usage policies, so point
# these at your own or a keyed provider before deploying publicly. See docs/self-hosting.md.
# VITE_BASEMAP_LIGHT_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_STYLE_DARK_URL=https://tiles.openfreemap.org/styles/dark
# VITE_MAP_STYLE_LIGHT_MONO_URL=https://tiles.openfreemap.org/styles/positron
# VITE_VECTOR_TILES_URL=https://tiles.openfreemap.org/planet
# VITE_MAP_GLYPHS_URL=https://fonts.openmaptiles.org/{fontstack}/{range}.pbf
